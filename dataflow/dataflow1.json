{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Yt_data",
						"type": "DatasetReference"
					},
					"name": "AllVideosSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Yt_data",
						"type": "DatasetReference"
					},
					"name": "YtVideoIdsOnlyStore",
					"rejectedDataLinkedService": {
						"referenceName": "ls_blob_ytrawdata",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "flattenItems"
				},
				{
					"name": "ExtractVideoId"
				}
			],
			"scriptLines": [
				"source(output(",
				"          etag as string,",
				"          items as (etag as string, id as (kind as string, videoId as string), kind as string, snippet as (channelId as string, channelTitle as string, description as string, liveBroadcastContent as string, publishTime as timestamp, publishedAt as timestamp, thumbnails as (default as (height as short, url as string, width as short), high as (height as short, url as string, width as short), medium as (height as short, url as string, width as short)), title as string))[],",
				"          kind as string,",
				"          nextPageToken as string,",
				"          pageInfo as (resultsPerPage as short, totalResults as short),",
				"          regionCode as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> AllVideosSource",
				"AllVideosSource foldDown(unroll(items),",
				"     mapColumn(",
				"          etag,",
				"          items,",
				"          kind,",
				"          nextPageToken,",
				"          pageInfo,",
				"          regionCode",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenItems",
				"flattenItems derive(video_id = items.id.videoId,",
				"          title = items.snippet.title) ~> ExtractVideoId",
				"ExtractVideoId sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> YtVideoIdsOnlyStore"
			]
		}
	}
}