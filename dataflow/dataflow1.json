{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Yt_data_store",
						"type": "DatasetReference"
					},
					"name": "AllVideosSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Yt_data_store",
						"type": "DatasetReference"
					},
					"name": "YtVideoIdsOnlyStore",
					"rejectedDataLinkedService": {
						"referenceName": "ls_blob_ytrawdata",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "flattenItems"
				},
				{
					"name": "ExtractVideoId"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> AllVideosSource",
				"AllVideosSource foldDown(unroll(items),",
				"     mapColumn(",
				"          etag,",
				"          items,",
				"          kind,",
				"          nextPageToken,",
				"          pageInfo,",
				"          regionCode",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenItems",
				"flattenItems derive(video_id = items.id.videoId,",
				"          title = items.snippet.title) ~> ExtractVideoId",
				"ExtractVideoId sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> YtVideoIdsOnlyStore"
			]
		}
	}
}