							"type": "SnowflakeImportCopyCommand"
						}
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "SAS_ls",
							"type": "LinkedServiceReference"
						},
						"path": "stage",
						"enableCompression": true
