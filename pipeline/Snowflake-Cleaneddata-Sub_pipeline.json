				"outputs": [
					{
						"referenceName": "Yt_Snowflake_table",
						"type": "DatasetReference",
						"parameters": {
							"TableName": {
								"value": "DIM_VIDEO",
								"type": "Expression"
							}
						}
					}
				]
			},
