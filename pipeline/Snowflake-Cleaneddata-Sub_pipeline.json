{
	"name": "Snowflake-Cleaneddata-Sub_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Yt-Cleaned-Dim_Video-data-Store",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
