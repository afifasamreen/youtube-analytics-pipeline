{
	"name": "Sub-pipeline-channels",
	"properties": {
		"activities": [
			{
				"name": "Lookup Into each VideoID",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "Yt_data_store",
						"type": "DatasetReference",
						"parameters": {
							"SubFolder": {
								"value": "@pipeline().parameters.ChannelName",
								"type": "Expression"
							},
							"FileName": {
								"value": "AllVideoIds",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "For Each VideoId",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup Into each VideoID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup Into each VideoID').output.value[0].items",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Fetch-VideoId-data-channel",
							"type": "WebActivity",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat('https://www.googleapis.com/youtube/v3/videos?part=snippet,statistics,contentDetails&id=', item().id.videoId,'&key=AIzaSyBCQ1GX9GVo768TWIaIWB02YauKYiBVgnc')\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Yt-VideoId-detail-store",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Fetch-VideoId-data-channel",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings",
										"copyBehavior": "FlattenHierarchy"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "Yt_URL_fetch",
									"type": "DatasetReference",
									"parameters": {
										"RelativeURL": {
											"value": "@concat('videos?part=snippet,statistics,contentDetails&id=', item().id.videoId, '&key=AIzaSyBCQ1GX9GVo768TWIaIWB02YauKYiBVgnc')\n",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "Yt_data_store",
									"type": "DatasetReference",
									"parameters": {
										"SubFolder": {
											"value": "@concat(item().snippet.channelTitle,'/',item().id.videoId)",
											"type": "Expression"
										},
										"FileName": {
											"value": "VideoInfo",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Fetch-Comments-data",
							"type": "WebActivity",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "Yt-VideoId-detail-store",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat('https://www.googleapis.com/youtube/v3/commentThreads?part=snippet&videoId=', item().id.videoId, '&key=AIzaSyBCQ1GX9GVo768TWIaIWB02YauKYiBVgnc')\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Yt-Comments-data-Store",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Fetch-Comments-data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings",
										"copyBehavior": "FlattenHierarchy"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "Yt_URL_fetch",
									"type": "DatasetReference",
									"parameters": {
										"RelativeURL": {
											"value": "@concat('commentThreads?part=snippet&videoId=', item().id.videoId, '&key=AIzaSyBCQ1GX9GVo768TWIaIWB02YauKYiBVgnc')\n\n\n",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "Yt_data_store",
									"type": "DatasetReference",
									"parameters": {
										"SubFolder": {
											"value": "@concat(item().snippet.channelTitle,'/',item().id.videoId)",
											"type": "Expression"
										},
										"FileName": {
											"value": "CommentsInfo",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"ChannelName": {
				"type": "string"
			}
		},
		"annotations": []
	}
}